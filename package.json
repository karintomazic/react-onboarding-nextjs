{
  "type": "module",
  "name": "react-onboarding-nextjs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "npm run build && tsc --noEmit && npm run format:check && eslint . && vitest run",
    "format:check": "prettier --check \"{app,components,utils,context,data,db,hooks,lib,mock,utils}/**/*.{js,ts,tsx,json,css,scss,md}\"",
    "format:write": "prettier --write \"{app,components,utils,context,data,db,hooks,lib,mock,utils}/**/*.{js,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "db:create": "drizzle-kit push",
    "db:inspect": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env db/seed.ts",
    "test:unit": "vitest run --project=unit"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@libsql/client": "^0.17.4",
    "@tanstack/react-query": "^5.101.4",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.0",
    "next": "16.4.1",
    "next-auth": "^4.24.15",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-mcp": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/nextjs-vite": "^10.6.3",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-storybook": "^10.6.3",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "sass": "^1.102.0",
    "storybook": "^10.6.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
